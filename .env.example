# Random long string used to sign login tokens. Use any long random text.
JWT_SECRET=change-this-to-a-long-random-string

# How many spots the event has
EVENT_CAPACITY=100

# Server port
PORT=3000

# ---- Staff login (used by seed script: npm run seed) ----
STAFF_USERNAME=staff
STAFF_PASSWORD=change-this-password

TURSO_DATABASE_URL=libsql://db-name-gh-username.location.turso.io
TURSO_AUTH_TOKEN=eystings-will-replaced-by-the-db-token

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Event Team <no-reply@example.com>"
